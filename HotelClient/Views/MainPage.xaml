<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:local="clr-namespace:HotelClient.Converters"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:HotelClient.Converters"
             x:Class="HotelClient.Views.MainPage"
             Title="Список отелей">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToAvailabilityConverter x:Key="BoolToAvailabilityConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Frame CornerRadius="10" BackgroundColor="#F5F5F5" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Поиск отелей" FontSize="16" FontAttributes="Bold" />

                    <Entry Placeholder="Название отеля" 
                           Text="{Binding SearchName}" 
                           ClearButtonVisibility="WhileEditing" />

                    <Entry Placeholder="Город" 
                           Text="{Binding SearchCity}" 
                           ClearButtonVisibility="WhileEditing" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <Label Text="Мин. рейтинг:" 
                               Grid.Row="0" Grid.Column="0" 
                               VerticalOptions="Center" />
                        <Entry Placeholder="0.0-5.0" 
                               Keyboard="Numeric" 
                               Text="{Binding MinRating}"
                               Grid.Row="0" Grid.Column="1" />

                        <Label Text="Только со свободными номерами:" 
                               Grid.Row="1" Grid.Column="0" 
                               VerticalOptions="Center" />
                        <Switch IsToggled="{Binding HasAvailableRooms, Mode=TwoWay}" 
                                HorizontalOptions="Start"
                                Grid.Row="1" Grid.Column="1" />
                    </Grid>

                    <Button Text="Найти отели" 
                            Command="{Binding SearchCommand}" 
                            BackgroundColor="#2196F3" 
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="50"
                            Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="Найденные отели:" FontSize="16" FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding Hotels}" 
                            SelectionMode="None" 
                            VerticalScrollBarVisibility="Always"
                            EmptyView="Отели не найдены. Попробуйте изменить параметры поиска.">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="10" 
               BackgroundColor="White" 
               Padding="15"
               HasShadow="True">
                            <Frame.Shadow>
                                <Shadow Brush="#40000000" 
                        Offset="0, 2" 
                        Radius="5" 
                        Opacity="0.2"/>
                            </Frame.Shadow>

                            <VerticalStackLayout Spacing="8">
                                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           LineBreakMode="TailTruncation"
                           VerticalOptions="Center" />
                                    <Frame BackgroundColor="#FF9800" 
                           CornerRadius="5" 
                           Padding="5,2"
                           HorizontalOptions="End">
                                        <Label Text="{Binding Rating, StringFormat='{0:F1}★'}" 
                               TextColor="White" 
                               FontSize="12"
                               FontAttributes="Bold" />
                                    </Frame>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="📍" FontSize="12" />
                                    <Label Text="{Binding City.Name}" 
                           FontSize="14" 
                           TextColor="Gray"
                           LineBreakMode="TailTruncation" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding HasAvailableRooms, Converter={StaticResource BoolToAvailabilityConverter}}" 
                       FontSize="14"/>
                                <Button Text="Забронировать" 
                        BackgroundColor="#4CAF50" 
                        TextColor="White"
                        CornerRadius="5"
                        HeightRequest="40"
                        Margin="0,5,0,0"
                        Clicked="OnBookButtonClicked" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>